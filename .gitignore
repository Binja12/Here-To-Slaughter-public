# Dependencies
node_modules/


# Build outputs
dist/
build/


# Environment files
.env
.env.local
# …except the client's dev-server port, which holds nothing secret
!client/.env


# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# NestJS
server/dist/

# TS build output emitted in place next to the sources
server/src/**/*.js
server/src/**/*.d.ts

# graphify report output
graphify-out/

# React
client/build/

# Coverage
coverage/

# graphify report output
graphify-out/


#calude
.claude/**
CLAUDE.md

#codex
.codex/**

# WebP twins the image build writes next to the PNG art (scripts/optimize-art.mjs)
client/public/**/*.png.webp

# The prepared IMAGES are committed: the Docker build must not re-encode 164
# PNGs on every run (docs/ONLINE_ASSET_PREPARATION.md). Music still needs ffmpeg
# and is made inside the build; the asset catalog is rebuilt by client prestart.
client/public/generated/*
!client/public/generated/online-art/
client/src/generated/
